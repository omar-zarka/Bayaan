<?xml version="1.0" encoding="utf-8"?>
<!-- Live time left inside the play pill. Glance has no chronometer, so this is
     embedded through AndroidRemoteViews and counts down with no updates. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bayaan_widget_countdown"
  android:layout_width="wrap_content"
  android:layout_height="match_parent"
  android:gravity="center_vertical"
  android:includeFontPadding="false"
  android:countDown="true"
  android:maxLines="1"
  android:textColor="#FFFFFFFF"
  android:textSize="12sp"
  android:textStyle="bold" />
